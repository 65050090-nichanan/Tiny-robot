void setup() {
  Serial.begin(9600);   // ส่งไป STM32  // เริ่มต้นการสื่อสารแบบ Serial ที่ความเร็ว (Baud rate) 9600 bps เพื่อใช้ส่งข้อมูลไป STM32
}

void loop() {
  Serial.println("HELLO");  // ส่งข้อความ "HELLO" พร้อมขึ้นบรรทัดใหม่ผ่านสาย Serial ไปยัง STM32
  delay(2000);              // หน่วงเวลาหยุดรอการทำงาน 2,000 มิลลิวินาที (2 วินาที) ก่อนเริ่มทำรอบต่อไป
}
